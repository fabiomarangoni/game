# Porta HTTP (o Render define automaticamente)
PORT=3000

# Tempo de cache dos preços, em milissegundos (padrão: 10 minutos)
CACHE_TTL_MS=600000

# Tempo máximo de espera por cada site de origem, em milissegundos
UPSTREAM_TIMEOUT_MS=20000

# Origem autorizada a chamar a API (CORS). Use o endereço do frontend em produção.
ALLOW_ORIGIN=*

# Endereços dos sites de origem (normalmente não é preciso mudar)
REIDOSCOINS_BASE=https://www.reidoscoins.com.br
TIBIATRADE_BASE=https://tibiatrade.gg
